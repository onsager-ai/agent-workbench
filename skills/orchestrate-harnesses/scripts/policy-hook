#!/usr/bin/env node
// Entry point kept at this path so existing hook entries stay valid; the logic is in policy-hook.mjs.
const [major, minor] = process.versions.node.split(".").map(Number);
if (major < 22 || (major === 22 && minor < 20)) {
  console.error(`agent-workbench: Node 22.20 or newer is required (found ${process.versions.node}).`);
  process.exit(1);
}
import("./policy-hook.mjs");
