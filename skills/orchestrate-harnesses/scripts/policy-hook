#!/usr/bin/env python3
"""Enforce Worker, GitHub polling, and user-question policies."""
import argparse
import json
from pathlib import Path
import re
import shlex
import subprocess
import sys


APPROVAL = "L3 Opus Worker needs the user's approval for this task (orchestrate-harnesses Worker ladder)."
PROTECTED_BRANCH_REASON = ("The local main branch is protected. Use a task branch, origin/main, "
                           "or git switch -c <task> origin/main.")
PROTECTED_BRANCHES = {"main", "master"}
POLLING = ("GitHub polling is disabled. Use watch_pull_request and the single-call status reads "
           "in orchestrate-harnesses' GitHub API budget section.")
T3_MODEL = ("Set target.model (and effort in target.options) for the Worker tier you chose "
            "before dispatching with delegate_task.")
INHERITED_MODEL = ("Built-in agents inherit the Manager's model. Use a tier agent "
                   "(subagent_type: <role>) or pass model explicitly.")
INHERITING_AGENT_TYPES = {None, "general-purpose", "Plan", "Explore", "claude"}
STOP_REASON = ("If this asks the user something, re-ask it with AskUserQuestion, putting the recommended "
               "option first and offering your best guesses as options for open-ended answers. "
               "If it was not a question to the user, end the turn without it.")
TRANSCRIPT_TAIL_BYTES = 256 * 1024


def polls_github(command):
    lexer = shlex.shlex(command, posix=True, punctuation_chars=";|&()\n")
    lexer.whitespace = " \t\r"
    tokens = []
    for token in lexer:
        tokens.extend(token if token and all(char in ";|&()\n" for char in token) else [token])
    separators = {";", "|", "&", "(", ")", "\n", "do", "then", "!", "while", "until"}
    commands = []
    loops, stack = [], []
    for index, token in enumerate(tokens):
        if index == 0 or tokens[index - 1] in separators:
            if token in ("while", "until", "for"):
                stack.append(index)
            elif token == "done" and stack:
                loops.append((stack.pop(), index))
            end = index + 1
            while end < len(tokens) and tokens[end] not in separators:
                end += 1
            commands.append((index, tokens[index:end]))
    for _, words in commands:
        if words[:3] == ["gh", "run", "watch"]:
            return True
        if words[:3] == ["gh", "pr", "checks"] and any(
                word == "--watch" or word.startswith("--watch=") for word in words[3:]):
            return True
    return any("do" in tokens[start:end] and
               any(start < index < end and words[0] == "sleep" for index, words in commands) and
               any(start < index < end and words[0] == "gh" for index, words in commands)
               for start, end in loops)


def shell_commands(command):
    lexer = shlex.shlex(command, posix=True, punctuation_chars=";|&()\n")
    lexer.whitespace = " \t\r"
    lexer.whitespace_split = True
    tokens = []
    for token in lexer:
        if token and set(token) <= set(";|&()\n"):
            tokens.extend(token)
        else:
            tokens.append(token)
    joined = []
    index = 0
    while index < len(tokens):
        if tokens[index:index + 2] == ["&", "&"]:
            joined.append("&&")
            index += 2
        elif tokens[index:index + 2] == ["|", "|"]:
            joined.append("||")
            index += 2
        else:
            joined.append(tokens[index])
            index += 1
    tokens = joined
    separators = {";", "|", "&", "&&", "||", "(", ")", "\n", "do", "then", "!", "while", "until"}
    commands = []
    current = []
    cd_prefix = None
    for token in tokens:
        if token in separators:
            if token in ("&&", "||") and current and current[0] == "cd":
                cd_prefix = current + [token]
                current = []
                continue
            if current:
                commands.append((cd_prefix or []) + current)
                cd_prefix = None
                current = []
        else:
            current.append(token)
    if current:
        commands.append((cd_prefix or []) + current)
    return commands


def git_command(words):
    """Return git argv, honoring `git -C <directory> ...`."""
    if not words or words[0] != "git":
        return None, None
    argv = words[1:]
    directory = None
    while len(argv) >= 2 and argv[0] == "-C":
        directory = argv[1]
        argv = argv[2:]
    return argv, directory


def resolve_git_context(event, git_cwd, cd_cwd=None):
    cwd = Path(event.get("cwd") or Path.cwd())
    if git_cwd:
        return (cwd / git_cwd).resolve() if not Path(git_cwd).is_absolute() else Path(git_cwd)
    if cd_cwd:
        path = Path(cd_cwd)
        return (cwd / path).resolve() if not path.is_absolute() else path
    return cwd.resolve()


def current_branch(directory):
    try:
        result = subprocess.run(["git", "-C", str(directory), "symbolic-ref", "--quiet", "--short", "HEAD"],
                                capture_output=True, text=True, timeout=2, check=False)
    except (OSError, subprocess.TimeoutExpired):
        return None
    return result.stdout.strip() if result.returncode == 0 else None


def protected_branch_git(command, event):
    reason = None
    for words in shell_commands(command):
        cd_cwd = words[1] if len(words) >= 4 and words[0] == "cd" and words[2] in ("&&", "||") else None
        if cd_cwd:
            words = words[3:]
        argv, git_cwd = git_command(words)
        if not argv:
            continue
        directory = resolve_git_context(event, git_cwd, cd_cwd)
        operation = argv[0]
        args = argv[1:]
        if operation in ("checkout", "switch") and args:
            branch = None
            if args[0] in ("-B", "-C") and len(args) > 1:
                branch = args[1]
            elif args[0] in ("-b", "-c"):
                branch = None
            elif args[0] == "-f" and len(args) > 1:
                branch = args[1]
            elif args[0].startswith("-"):
                continue
            else:
                branch = args[0]
            if branch in PROTECTED_BRANCHES:
                # `git checkout <branch> [--] <paths>` restores files, it does not switch branches.
                if operation == "checkout" and len(args) > 1 and args[0] not in ("-B", "-b", "-f"):
                    continue
                return PROTECTED_BRANCH_REASON
        if operation == "worktree" and len(args) >= 3 and args[0] == "add":
            branch_args = args[1:]
            if "-b" in branch_args or "-B" in branch_args:
                continue
            if branch_args[-1] in PROTECTED_BRANCHES:
                return PROTECTED_BRANCH_REASON
        if operation == "push":
            refs = [arg for arg in args if not arg.startswith("-")]
            refspecs = [ref.lstrip("+") for ref in refs[1:]]
            if any(ref.split(":", 1)[-1].removeprefix("refs/heads/") in PROTECTED_BRANCHES
                   or ref.split(":", 1)[0].removeprefix("refs/heads/") in PROTECTED_BRANCHES
                   for ref in refspecs):
                return PROTECTED_BRANCH_REASON
            # With no refspec, or a HEAD/@ source, the pushed branch is the current one.
            if refspecs and not any(ref.split(":", 1)[0] in ("HEAD", "@") for ref in refspecs):
                continue
        elif operation not in {"commit", "merge", "rebase", "cherry-pick", "revert", "reset", "am"}:
            continue
        if current_branch(directory) in PROTECTED_BRANCHES:
            return PROTECTED_BRANCH_REASON
    return reason


def last_assistant_text(event):
    message = event.get("last_assistant_message")
    if isinstance(message, str):
        return message
    path = event.get("transcript_path")
    if not isinstance(path, str):
        return ""
    with open(path, "rb") as transcript:
        transcript.seek(0, 2)
        size = transcript.tell()
        transcript.seek(max(0, size - TRANSCRIPT_TAIL_BYTES))
        tail = transcript.read(TRANSCRIPT_TAIL_BYTES)
    entries = []
    for line in tail.splitlines():
        try:
            entry = json.loads(line)
        except (ValueError, TypeError):
            continue
        if isinstance(entry, dict) and entry.get("type") == "assistant":
            entries.append(entry)
    for entry in reversed(entries):
        content = entry.get("message", {}).get("content", [])
        if not isinstance(content, list):
            continue
        text = "".join(block.get("text", "") for block in content
                       if isinstance(block, dict) and block.get("type") == "text"
                       and isinstance(block.get("text"), str))
        if text:
            return text
    return ""


def ends_with_question(text):
    return re.sub(r"[\s*_`~]+$", "", text).endswith(("?", "？"))


def dispatch_approval(path, event, tier):
    try:
        if path is None:
            raise OSError("missing workers path")
        with open(path) as source:
            bundle = json.load(source)
        cwd = Path(event.get("cwd") or Path.cwd()).resolve()
        profile = bundle["profile"]
        for rule in bundle["select"]:
            if cwd.is_relative_to(rule["path"]):
                profile = rule["profile"]
                break
        config = bundle["profiles"][profile] if profile else bundle["base"]
        known = {name for item in [bundle["base"], *bundle["profiles"].values()] for name in item["tiers"]}
        if tier not in known or config["tiers"].get(tier, {}).get("opt_in"):
            return None
        for level in config["ladder"]:
            if tier in level["tiers"]:
                if level.get("approval") == "required":
                    return f"Worker {tier} at level {level['level']} needs the user's approval for this task (configured Worker ladder)."
                return None
        return (f"Worker {tier} is not in the ladder for profile {profile or 'base'} at {cwd}; "
                "dispatch it only with the user's approval.")
    except (OSError, ValueError, TypeError, KeyError, AttributeError):
        return "Worker policy configuration is missing or unreadable; rerun agent-workbench install before dispatching Workers."
    return None


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--workers", type=Path)
    args = parser.parse_args()
    try:
        event = json.load(sys.stdin)
        if not isinstance(event, dict):
            return
        if event.get("hook_event_name") == "Stop":
            if event.get("stop_hook_active"):
                return
            try:
                if ends_with_question(last_assistant_text(event)):
                    print(json.dumps({"decision": "block", "reason": STOP_REASON}))
            except (OSError, ValueError, TypeError, AttributeError):
                return
            return
        if event.get("hook_event_name") not in (None, "PreToolUse"):
            return
        tool = event.get("tool_name")
        arguments = event.get("tool_input", {})
        decision = reason = None
        if tool == "mcp__t3-code__delegate_task":
            target = arguments.get("target", {})
            if not target.get("model"):
                decision, reason = "deny", T3_MODEL
        elif tool in ("Agent", "Task"):
            subagent_type = arguments.get("subagent_type")
            approval = dispatch_approval(args.workers, event, subagent_type)
            if approval:
                decision, reason = "ask", approval
            elif arguments.get("model") == "opus":
                decision, reason = "ask", APPROVAL
            elif subagent_type in INHERITING_AGENT_TYPES and not arguments.get("model"):
                decision, reason = "deny", INHERITED_MODEL
        elif tool == "Bash":
            command = arguments.get("command", "")
            branch_reason = protected_branch_git(command, event)
            if branch_reason:
                decision, reason = "deny", branch_reason
            elif polls_github(command):
                decision, reason = "deny", POLLING
    except (ValueError, TypeError, AttributeError):
        return
    if decision:
        print(json.dumps({"hookSpecificOutput": {"hookEventName": "PreToolUse",
                                                "permissionDecision": decision,
                                                "permissionDecisionReason": reason}}))


if __name__ == "__main__":
    main()
