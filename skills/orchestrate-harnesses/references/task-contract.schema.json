{
  "type": "object",
  "required": ["version", "cwd", "objective", "complexity", "allowed_paths", "acceptance_criteria", "authorization", "read_only", "verification", "source"],
  "properties": {
    "version": {"const": 1},
    "cwd": {"type": "string"},
    "objective": {"type": "string", "minLength": 1},
    "complexity": {"enum": ["simple", "normal", "complex", "critical"]},
    "allowed_paths": {"type": "array", "items": {"type": "string"}},
    "acceptance_criteria": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "authorization": {"type": "object", "required": ["implementation", "commit", "push", "merge", "deploy", "publish"], "properties": {"implementation": {"type": "boolean"}, "commit": {"type": "boolean"}, "push": {"type": "boolean"}, "merge": {"const": false}, "deploy": {"const": false}, "publish": {"const": false}}},
    "read_only": {"type": "boolean"},
    "verification": {"type": "object", "required": ["ci_required", "evidence_files", "exemption_reason"], "properties": {"ci_required": {"type": "boolean"}, "evidence_files": {"type": "array", "items": {"type": "string"}}, "exemption_reason": {"type": "string"}}},
    "sol_usage": {"type": "object"},
    "source": {"type": "object", "required": ["kind", "reference"], "properties": {"kind": {"const": "user_message"}, "reference": {"type": "string", "minLength": 1}}}
  },
  "additionalProperties": false
}
